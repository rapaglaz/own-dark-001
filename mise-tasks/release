#!/bin/sh
#MISE description="Bump version, update CHANGELOG.md, tag, create GitHub release and publish to the Marketplace"
set -eu

# Not set via "#MISE env", because task env overrides the caller environment.
dry_run=${DRY_RUN:-0}

current=$(git describe --tags --abbrev=0)
next=$(git cliff --bumped-version 2>/dev/null)

# git-cliff returns the current tag when only non-releasable commits exist.
if [ "$next" = "$current" ]; then
  echo "No releasable commits since $current, nothing to release."
  exit 0
fi

version=${next#v}
vsix="own-dark-001-$version.vsix"
echo "Releasing $current -> $next"

notes=$(git cliff --unreleased --tag "$next" --strip all 2>/dev/null)

pnpm version "$version" --no-git-tag-version --no-git-checks >/dev/null
# Prepend only, because entries before 0.3.0 were removed on purpose and must not be regenerated.
git cliff --unreleased --tag "$next" --prepend CHANGELOG.md 2>/dev/null
pnpm exec vsce pack --no-dependencies -o "$vsix"

if [ "$dry_run" = "1" ]; then
  echo "DRY_RUN=1: skip commit, tag, push, GitHub release and Marketplace publish."
  printf '\n--- Release notes ---\n%s\n' "$notes"
  exit 0
fi

git add CHANGELOG.md package.json
git commit -m "chore(release): $version [skip ci]" -m "$notes"
# Annotated tag, so that it also works with tag.gpgSign enabled.
git tag -a "$next" -m "$version"
git push --atomic origin HEAD "$next"

gh release create "$next" "$vsix" --title "$version" --notes "$notes" --verify-tag
pnpm exec vsce publish --packagePath "$vsix"
