{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "timezone": "Europe/Berlin",
  "schedule": ["before 10am on monday"],
  "dependencyDashboardTitle": "Dependency Dashboard",
  "dependencyDashboardLabels": ["dependencies"],
  "labels": ["dependencies"],
  "prConcurrentLimit": 7,
  "prHourlyLimit": 3,
  "internalChecksFilter": "strict",
  "separateMajorMinor": true,
  "minimumReleaseAge": "3 days",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 3am on the first day of the month"],
    "automerge": true,
    "automergeType": "pr",
    "automergeStrategy": "squash"
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "groupName": null,
    "schedule": ["at any time"],
    "vulnerabilityFixStrategy": "highest"
  },
  "packageRules": [
    {
      "description": "One weekly PR for all stable patch, digest and pin updates (automerged below)",
      "matchCurrentVersion": "!/^0/",
      "matchUpdateTypes": ["patch", "digest", "pin"],
      "groupName": "patch dependencies"
    },
    {
      "description": "One weekly PR for all stable minor updates (merged manually)",
      "matchCurrentVersion": "!/^0/",
      "matchUpdateTypes": ["minor"],
      "groupName": "minor dependencies"
    },
    {
      "description": "Require approval for all major updates",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "automerge": false,
      "labels": ["major-update"]
    },
    {
      "description": "Create PR for stable minor updates",
      "matchCurrentVersion": "!/^0/",
      "matchUpdateTypes": ["minor"],
      "automerge": false
    },
    {
      "description": "Automerge stable patch updates",
      "matchCurrentVersion": "!/^0/",
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "description": "Require approval for unstable 0.x updates",
      "matchCurrentVersion": "/^0/",
      "matchUpdateTypes": ["minor", "patch"],
      "dependencyDashboardApproval": true,
      "automerge": false,
      "labels": ["unstable-version"]
    }
  ]
}
